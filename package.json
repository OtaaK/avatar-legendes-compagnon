{
  "name": "avatar-legendes-compagnon",
  "version": "2.33.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config apps/companion/vite.config.ts --host 127.0.0.1",
    "build": "tsc --noEmit -p apps/companion/tsconfig.json && vite build --config apps/companion/vite.config.ts",
    "test:extraction": "node scripts/convergence/extract-domain.mjs --check",
    "test:contracts": "node --test tests/convergence/*.test.mjs",
    "test:parity": "node scripts/convergence/test-parity.mjs",
    "test:react": "python tests/convergence/browser.py",
    "test:inventory": "node scripts/convergence/inventory.mjs --check",
    "test:characters": "python tests/convergence/characters_browser.py",
    "test:library": "python tests/convergence/library_browser.py",
    "test:places": "python tests/convergence/places_browser.py",
    "test:playbooks": "node --test tests/convergence/playbooks-preparation.test.mjs && tsc --noEmit --strict --module esnext --moduleResolution bundler --target es2022 packages/application/src/playbook-preparation.d.ts packages/application/src/playbook-commands.d.ts"
  },
  "dependencies": {
    "lucide-react": "1.16.0",
    "pdfjs-dist": "5.4.394",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.3",
    "vite": "8.3.6",
    "vite-plugin-singlefile": "2.3.4"
  }
}
